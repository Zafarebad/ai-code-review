# ─────────────────────────────────────────────────────────────
# AI Code Review Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────

# URL to your n8n webhook workflow ("AI Code Review – Webhook")
# Example: https://n8n.yourdomain.com/webhook/ai-code-review
# In development, leaving this empty will safely activate Mock Simulation Mode.
N8N_WEBHOOK_URL=

# Note:
# GITHUB_TOKEN, ANTHROPIC_API_KEY, and TELEGRAM_BOT_TOKEN are NEVER configured
# in Next.js. They reside exclusively inside your n8n Credentials store for maximum security.
